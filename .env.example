# Public site URL — canonical links, sitemap, YooKassa return URL.
NEXT_PUBLIC_SITE_URL=https://cheapi.ru

# Search engine verification. Paste the codes from Google Search Console and
# Yandex Webmaster after adding the domain there.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Upstream provider. Without CODEX_SALE_API_KEY, dev returns a mock for
# chat completions; production returns 503 until the key is set.
CODEX_SALE_API_KEY=
CODEX_SALE_BASE=https://codex.sale
UPSTREAM_TIMEOUT_MS=180000

# SQLite database (node:sqlite). Relative paths resolve from the project root.
DATABASE_PATH=./data/cheapi.db

# Tokens credited to new accounts. Set 0 to disable the welcome bonus.
WELCOME_TOKENS=5000000

# YooKassa. Top-ups return 503 until both values are configured.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
